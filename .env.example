# AST-Guided Neuro-Symbolic RAG System Configuration

# LLM Configuration (Options: gemini, openai, anthropic, local)
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Embedding Configuration
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Graph Store Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
USE_EMBEDDED_GRAPH=true

# Vector Store Configuration
VECTOR_DB_PATH=workspace/vector_store.json

# Retrieval & Repair Hyperparameters
TOP_K=5
GRAPH_HOPS=2
MAX_REPAIR_ATTEMPTS=3

# Environment & Compilers
JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
COBOL_COMPILER=builtin
NUMERIC_TOLERANCE=0.001
HOST=0.0.0.0
PORT=8000
